  "source": {
    "repository": "vornicx/archic-design-system",
    "path": "05-standards/03-quality-gate.md",
    "sha": "fa3c04edbcaa5c0f7d26eb2460dc1b22a4c2f7be"
  },
  "intent": "Quality is pass/fail. Scores prioritize work; they never override a blocking failure.",
  "thresholds": {
    "benchmarkScoreForApproval": 90,
    "lcpMs": 2000,
    "inpMs": 200,
    "cls": 0.05,
    "lighthouse": {
      "performance": 90,
      "accessibility": 95,
      "bestPractices": 95,
      "seo": 95
    },
    "touchTargetPx": 44,
    "touchTargetSeparationPx": 8
  },
  "promotionPolicy": {
    "preview": [
      "all automated blocking checks pass",
      "no critical findings",
      "no unresolved critical journey failure"
    ],
    "humanApproval": [
      "preview policy passes",
      "manual evidence complete or exception documented",
      "benchmark score >= 90",
      "polish pass ready"
    ],
    "production": [
      "Vadim approves final_approval decision",
      "main branch checks pass",
      "deployment smoke tests pass"
    ]
  },
  "needsVadimPolicy": {
    "allowedDecisionTypes": [
      "final_approval",
      "brand_direction",
      "risk_acceptance",
      "scope_change",
      "irreversible_action"
    ],
    "suppress": [
      "retryable automation failure",
      "ordinary QA finding",
      "benchmark regression with known fix",
      "successful run"
    ],
    "escalateAfterRetries": 3
  },
