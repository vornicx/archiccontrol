# Postgres (pooled Neon URL in production)
DATABASE_URL=

# Owner access. Production refuses the local fallback.
CONTROL_ACCESS_KEY=
SESSION_SECRET=

# Machine-to-machine integrations
INTEGRATION_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM may use literal \\n sequences in Vercel.
GITHUB_APP_PRIVATE_KEY=
# Optional fallback for local development; prefer GitHub App credentials.
GITHUB_AUTOMATION_TOKEN=
AGENT_SECRET=
CRON_SECRET=

# Current benchmark source
BENCHMARK_URL=https://archicbenchmark.vercel.app/api/latest.json
