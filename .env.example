# Postgres (pooled Neon URL in production)
DATABASE_URL=

# Public callback origin. Optional on Vercel, where VERCEL_PROJECT_PRODUCTION_URL is used automatically.
CONTROL_PUBLIC_URL=https://control.archic.es

# Owner access for the private Control surface
CONTROL_ACCESS_KEY=
SESSION_SECRET=

# Machine-to-machine integrations
INTEGRATION_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM may use literal \\n sequences in Vercel.
GITHUB_APP_PRIVATE_KEY=
# Optional for pull-based repository autofix workers. Required for central repository dispatch,
# daily prototype repository creation and other Control-owned GitHub writes unless a GitHub App is configured.
GITHUB_AUTOMATION_TOKEN=
GITHUB_PROSPECT_OWNER=vornicx
# Legacy/shared bearer for non-OIDC agent clients. GitHub repository workers use scoped OIDC + lease tokens.
AGENT_SECRET=
CRON_SECRET=

# Central AI runtime. Minimum required with DATABASE_URL for pull-based bounded autofix.
OPENAI_API_KEY=
# Optional OpenAI-compatible root URL, e.g. https://api.example.com or https://api.example.com/v1.
# AUTOFIX_API_BASE_URL takes precedence when set; ARCHIC_OPENAI_BASE_URL keeps benchmark + Control configuration aligned.
ARCHIC_OPENAI_BASE_URL=
AUTOFIX_API_BASE_URL=
AUTOFIX_MODEL=gpt-5.6-terra
# Keep full-file repair output useful without asking Terra for an unnecessarily large 24k-token response.
AUTOFIX_MAX_OUTPUT_TOKENS=12000
# Must remain below the autofix-plan function maxDuration; workers should allow slightly more than this value.
AUTOFIX_REQUEST_TIMEOUT_MS=95000

# Daily commercial prospecting
PROSPECTING_MODEL=gpt-5-mini
PROSPECTING_MIN_SCORE=80
PROSPECTING_FRESH_DAYS=30
PROSPECT_REPOS_PRIVATE=false

# Vercel publication for generated prototypes
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Current benchmark source
BENCHMARK_URL=https://archicbenchmark.vercel.app/api/latest.json
