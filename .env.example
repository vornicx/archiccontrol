# Postgres (pooled Neon URL in production)
DATABASE_URL=

# Machine-to-machine integrations
INTEGRATION_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
# PEM may use literal \\n sequences in Vercel.
GITHUB_APP_PRIVATE_KEY=
# Personal GitHub token used by Control for autonomous repository dispatch and daily prototype repository creation.
# It must be able to create repositories for GITHUB_PROSPECT_OWNER and write their contents.
GITHUB_AUTOMATION_TOKEN=
GITHUB_PROSPECT_OWNER=vornicx
AGENT_SECRET=
CRON_SECRET=

# Daily commercial prospecting
OPENAI_API_KEY=
PROSPECTING_MODEL=gpt-5-mini
PROSPECTING_MIN_SCORE=80
PROSPECTING_FRESH_DAYS=30
PROSPECT_REPOS_PRIVATE=false

# Vercel publication for generated prototypes
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Current benchmark source
BENCHMARK_URL=https://archicbenchmark.vercel.app/api/latest.json
